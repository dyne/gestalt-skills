file(REMOVE "${REPORT}")
set(filter "${CASE}")
set(count 1)
if(CASE STREQUAL "count_mismatch")
    set(filter core.settings)
    set(count 2)
endif()
execute_process(COMMAND "${RUNNER}" "${filter}" "${REPORT}" "${count}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
file(WRITE "${REPORT}.log" "${output}\n${errors}")
if(NOT "${result}" STREQUAL "1")
    message(FATAL_ERROR "Expected exit 1, got ${result}; see ${REPORT}.log")
endif()
if(CASE STREQUAL "failure_probe")
    set(expected "tested=1 passed=0 expected=1 remaining=0")
elseif(CASE STREQUAL "count_mismatch")
    set(expected "tested=1 passed=1 expected=2 remaining=0")
else()
    set(expected "tested=0 passed=0 expected=1 remaining=0")
endif()
string(FIND "${output}" "${expected}" found)
if(found EQUAL -1 OR NOT EXISTS "${REPORT}")
    message(FATAL_ERROR "Missing expected rejection summary/report; see ${REPORT}.log")
endif()
message(STATUS "Expected rejection confirmed: ${CASE}; ${expected}")
